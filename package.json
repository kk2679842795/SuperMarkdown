{
  "name": "supermarkdown",
  "productName": "SuperMarkdown",
  "version": "0.2.1",
  "description": "免费开源的跨平台 Markdown 编辑器 —— 所见即所得，追求超越 Typora 的体验",
  "author": "SuperMarkdown Contributors",
  "license": "MIT",
  "main": "out/main.cjs",
  "private": true,
  "scripts": {
    "dev": "npm run build:main && concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=out/main.cjs --format=cjs && esbuild src/preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=out/preload.cjs --format=cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "esbuild scripts/test-core.ts --bundle --platform=node --format=cjs --outfile=out/test-core.cjs && node out/test-core.cjs",
    "build": "npm run typecheck && npm run build:main && vite build",
    "icon": "electron scripts/gen-icon.mjs",
    "inline-katex": "node scripts/inline-katex.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "prosemirror-commands": "^1.6.2",
    "prosemirror-dropcursor": "^1.0.0",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-list": "^1.4.2",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.38.1",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
